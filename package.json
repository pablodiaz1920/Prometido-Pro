{
  "name": "prometido-pro",
  "version": "4.0.0",
  "private": true,
  "description": "CRM del ciclo hormonal — PWA offline con autoguardado local",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/styles.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/styles.css --watch",
    "icons": "node scripts/make-icons.js",
    "serve": "npx --yes http-server -c-1 -p 8080 ."
  },
  "devDependencies": {
    "sharp": "0.33.5",
    "tailwindcss": "3.4.17"
  }
}
